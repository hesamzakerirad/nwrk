{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nwrk.ir/schema/community-profile.v1.json",
  "title": "NWRK community measurement profile, version 1",
  "description": "An approved, immutable list of endpoints and limits. The CLI embeds profiles. The server seeds its catalogue from the same files. A published profile never changes: a change needs a new profile version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "description", "limits", "services", "endpoints"],
  "properties": {
    "schema_version": { "const": "community-profile.v1" },
    "id": { "$ref": "#/$defs/slug" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "timeouts_ms", "total_budget_ms"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "timeouts_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dns", "tcp", "tls", "http"],
          "properties": {
            "dns": { "$ref": "#/$defs/timeout" },
            "tcp": { "$ref": "#/$defs/timeout" },
            "tls": { "$ref": "#/$defs/timeout" },
            "http": { "$ref": "#/$defs/timeout" }
          }
        },
        "total_budget_ms": { "type": "integer", "minimum": 10000, "maximum": 300000 }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/service" }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/endpoint" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 1, "maxLength": 64 },
    "timeout": { "type": "integer", "minimum": 500, "maximum": 30000 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "official_url"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "enum": ["international", "reference", "domestic", "developer"] },
        "official_url": { "type": "string", "pattern": "^https://[a-z0-9.-]+/$", "maxLength": 200 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id", "service_id", "hostname", "port", "scheme", "path", "method",
        "families", "measurement_types", "redirect_policy", "max_response_bytes"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/slug" },
        "service_id": { "$ref": "#/$defs/slug" },
        "hostname": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "port": { "const": 443 },
        "scheme": { "const": "https" },
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
          "maxLength": 200
        },
        "method": { "enum": ["GET", "HEAD"] },
        "families": {
          "description": "Address families the endpoint serves natively. A family that is not listed is never measured.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["ipv4", "ipv6"] }
        },
        "measurement_types": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["dns", "tcp", "tls", "http"] }
        },
        "redirect_policy": {
          "description": "none: the first response is the result. follow: not allowed in profile version 1.",
          "const": "none"
        },
        "max_response_bytes": {
          "description": "Body bytes the client may read. Zero with HEAD.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "if": { "properties": { "method": { "const": "HEAD" } }, "required": ["method"] },
      "then": { "properties": { "max_response_bytes": { "const": 0 } } }
    }
  }
}
